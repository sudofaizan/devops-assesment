}
run() {
	if [ "$1" == "--docker" ]; then
		show yellow "running on docker"
		if docker images | grep dexterquazi/openprovider >/dev/null 2>&1; then
			show green "INFO: image found running it"
			docker rm -f daemon-openprovider
			if docker run -it --name daemon-openprovider -p 8080:8080 dexterquazi/openprovider; then
				show green "running app in docker"
			else
				show red "ERROR: running app"
			fi
		else
			show yellow "WARNING: No image found building one"
			build --docker
			run --docker
		fi
	else
		netstat -an | grep 8080
		show yellow "INFO: Checking if postgress running"
		if curl localhost:5432 2>&1 | grep "Empty reply from server"; then
			show green "Postgress is running booting up app"
			show green "INFO: running app"
			if ./app; then
				show green "INFO: ran successfully"
				exit 0
			else
				show red "ERROR: err running app"
				exit 1
			fi
		else
			show red "postgress not running on 5432"
		fi
	fi
}
push() {
	if docker images dexterquazi/openprovider:$(git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/ | head -n 1 | xargs -I {} git log -1 --format="%H" {}|cut -b 1-7); then
		docker push dexterquazi/openprovider:$(git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/ | head -n 1 | xargs -I {} git log -1 --format="%H" {}|cut -b 1-7)
	else
		show red "Build image first"
	fi

}
build() {
	if [ "$1" == "--docker" ]; then
		show grey "INFO: checking dockerfile"
		if ls Dockerfile >/dev/null 2>&1; then
			show yellow "------Building Image-------"
			TAG=$(git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/ | head -n 1 | xargs -I {} git log -1 --format="%H" {}|cut -b 1-7)
			show green "building image with name dexterquazi/openprovider:$TAG"
			docker build -t dexterquazi/openprovider:$TAG .
		else
			show red "ERROR: No Dockerfile present in $(pwd)"
			return 1
		fi
	else
		echo "------Building locally-------"
		show grey "INFO: checking for dependency"
		if go mod tidy; then
			show green "INFO: building executable"
		else
			show red "ERROR: handling dependency"
		fi
		if go build -o app; then
			show grey "INFO: setting up permisson"
			chmod 777 app
		else
			show red "ERROR: setting permisson"
		fi
	fi
}

main() {
	$@
}
main "$@"
