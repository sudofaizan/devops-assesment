}
build() {
	if [ "$1" == "--docker" ]; then
		show grey "INFO: checking dockerfile"
		if ls Dockerfile >/dev/null 2>&1; then
			show yellow "------Building Image-------"
            TAG=$(git rev-parse HEAD|cut -b 1-9)
            show green "building image with name dexterquazi/openprovider:$TAG"
			docker build -t dexterquazi/openprovider:$TAG .
		else
			show red "ERROR: No Dockerfile present in $(pwd)"
			return 1
		fi
	else
		echo "------Building locally-------"
		show grey "INFO: checking for dependency"
		if go mod tidy; then
			show green "INFO: building executable"
		else
			show red "ERROR: handling dependency"
		fi
		if go build -o app; then
			show grey "INFO: setting up permisson"
			chmod 777 app
		else
			show red "ERROR: setting permisson"
		fi
	fi
}

main() {
	$@
}
main "$@"
