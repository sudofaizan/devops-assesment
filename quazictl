	docker run -d --name appd --network openprovider-test --rm -p 8080:8080 dexterquazi/openprovider:$(git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/ | head -n 1 | xargs -I {} git log -1 --format="%H" {}|cut -b 1-7)
